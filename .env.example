# =====================================================================
# LOT Bot - Plantilla de variables de entorno
# ---------------------------------------------------------------------
# Copia este fichero a `.env` y rellena los valores reales.
# `.env` esta en .gitignore: NUNCA se sube al repositorio.
# =====================================================================

# ---------------------------------------------------------------------
# MODO DE FUNCIONAMIENTO
# ---------------------------------------------------------------------
# true  -> MockWallapopService (datos simulados, no toca Wallapop)
# false -> intenta el acceso autorizado definido en el perfil de acceso
LOT_BOT_DEMO_MODE=true

# Entorno: development | production
LOT_BOT_ENV=development

# Nivel de log: DEBUG | INFO | WARNING | ERROR
LOT_BOT_LOG_LEVEL=INFO

# Idioma de la interfaz: es | en
LOT_BOT_LANGUAGE=es

# ---------------------------------------------------------------------
# ACCESO A WALLAPOP
# ---------------------------------------------------------------------
# LOT Bot NO exige una API key. El mecanismo de acceso es el que Wallapop
# haya autorizado y se declara en el perfil de acceso.
#
# Ruta al perfil de acceso autorizado. Se rellena copiando
# `config/access_profile.example.yaml` y completandolo EXCLUSIVAMENTE con
# lo que Wallapop indique. Sin el, LOT Bot se queda en modo DEMO.
WALLAPOP_ACCESS_PROFILE=

# Direccion local a la que vuelve el flujo de autenticacion. Wallapop debe
# tenerla registrada como destino valido.
WALLAPOP_REDIRECT_URI=http://127.0.0.1:8723/callback

# ---------------------------------------------------------------------
# SOLO SI EL MECANISMO AUTORIZADO ES OAUTH
# ---------------------------------------------------------------------
# Deja estas variables vacias si tu acceso NO es OAuth: los demas
# mecanismos (inicio de sesion autorizado, credencial delegada) no las usan.
WALLAPOP_CLIENT_ID=
WALLAPOP_CLIENT_SECRET=
WALLAPOP_SCOPES=

# ---------------------------------------------------------------------
# COMPATIBILIDAD
# ---------------------------------------------------------------------
# Nombre anterior de WALLAPOP_ACCESS_PROFILE. Se sigue aceptando.
WALLAPOP_ENDPOINT_MAP=

# ---------------------------------------------------------------------
# PROVEEDOR DE IA
# ---------------------------------------------------------------------
# provider: anthropic | rules
#   anthropic -> lenguaje natural completo (requiere API key)
#   rules     -> interprete local de ordenes, sin conexion a IA externa
LOT_BOT_AI_PROVIDER=rules
ANTHROPIC_API_KEY=
LOT_BOT_AI_MODEL=claude-sonnet-5
LOT_BOT_AI_MAX_TOKENS=4096

# ---------------------------------------------------------------------
# CIFRADO LOCAL
# ---------------------------------------------------------------------
# Clave maestra para cifrar las credenciales en la base de datos local.
# Si se deja vacia, LOT Bot la genera y la guarda en el almacen de
# credenciales del sistema operativo (recomendado).
LOT_BOT_MASTER_KEY=

# ---------------------------------------------------------------------
# NEGOCIO (valores por defecto de las plantillas)
# ---------------------------------------------------------------------
LOT_BOT_BUSINESS_WHATSAPP=
LOT_BOT_BUSINESS_NAME=
